{
  "name": "quickstart.to",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm gen && astro dev --root site",
    "build": "pnpm validate && pnpm gen && astro build --root site",
    "preview": "astro preview --root site",
    "validate": "node scripts/validate-topics.mjs && node scripts/check-typography.mjs",
    "test:typography": "node --test scripts/typography.test.mjs",
    "gen": "node scripts/gen-redirects.mjs",
    "deploy": "pnpm build && wrangler deploy --config site/wrangler.jsonc",
    "check": "astro check --root site"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "astro": "^7.3.7",
    "parse5": "7.3.0",
    "sharp": "^0.35.5",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.40.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
