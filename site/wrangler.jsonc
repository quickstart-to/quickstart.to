{
  // P0: static assets only. P2 adds a Worker entry for /api/* (auth, annotations) plus D1 bindings.
  // Deployed automatically by Cloudflare Workers Builds on every push to main (see docs/deploy.md).
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "quickstart-to",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "quickstart.to", "custom_domain": true }
  ],
  // Required by `wrangler preview` (per-branch / per-PR preview deployments in Workers Builds)
  "previews": {},
  "assets": {
    "directory": "./dist",
    // build.format = "file" emits go-global.html; "auto-trailing-slash" serves it at /go-global
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
