---
import { render } from 'astro:content';
import TopicLayout from '../../layouts/Topic.astro';
import { getTopics, getChapters } from '../../lib/topics';
import ValidationMedia from '../../../../topics/go-global/assets/ValidationMedia.astro';
import LaunchMedia from '../../../../topics/go-global/assets/LaunchMedia.astro';
import InfrastructureMedia from '../../../../topics/go-global/assets/InfrastructureMedia.astro';
import PricingMedia from '../../../../topics/go-global/assets/PricingMedia.astro';
import PaymentMedia from '../../../../topics/go-global/assets/PaymentMedia.astro';
import MarketMedia from '../../../../topics/go-global/assets/MarketMedia.astro';
import RetentionMedia from '../../../../topics/go-global/assets/RetentionMedia.astro';
import PayoutMedia from '../../../../topics/go-global/assets/PayoutMedia.astro';

export async function getStaticPaths() {
  const paths = [];
  for (const topic of await getTopics()) {
    const chapters = await getChapters(topic.id);
    for (const chapter of chapters) {
      paths.push({ params: { topic: topic.id, chapter: chapter.slug }, props: { topic, chapters, chapter } });
    }
  }
  return paths;
}

const { topic, chapters, chapter } = Astro.props;
const { entry } = chapter;
const { Content } = await render(entry);
---

<TopicLayout
  topic={topic}
  chapters={chapters}
  current={chapter.slug}
  title={entry.data.title}
  description={entry.data.description}
  path={`/${topic.id}/${chapter.slug}`}
  lastVerified={entry.data.last_verified}
  volatility={entry.data.volatility}
  sourcesHref={entry.rendered?.html.includes('id="sources-heading"') ? '#sources-heading' : undefined}
>
  <Content />
  {topic.id === 'go-global' && chapter.slug === 'validate-idea' && <ValidationMedia />}
  {topic.id === 'go-global' && chapter.slug === 'launch' && <LaunchMedia />}
  {topic.id === 'go-global' && chapter.slug === 'infrastructure' && <InfrastructureMedia />}
  {topic.id === 'go-global' && chapter.slug === 'pricing' && <PricingMedia />}
  {topic.id === 'go-global' && chapter.slug === 'payments' && <PaymentMedia />}
  {topic.id === 'go-global' && chapter.slug === 'market-fit' && <MarketMedia />}
  {topic.id === 'go-global' && chapter.slug === 'retention' && <RetentionMedia />}
  {topic.id === 'go-global' && chapter.slug === 'payouts' && <PayoutMedia />}
</TopicLayout>
