---
import { getEntry, render } from 'astro:content';
import TopicLayout from '../../layouts/Topic.astro';
import { getTopics, getChapters } from '../../lib/topics';
import { uiLangFor, t } from '../../i18n';

export async function getStaticPaths() {
  return (await getTopics()).map((topic) => ({ params: { topic: topic.id }, props: { topic } }));
}

const { topic } = Astro.props;
const chapters = await getChapters(topic.id);
const changelog = await getEntry('changelogs', topic.id);
const rendered = changelog ? await render(changelog) : null;
const Content = rendered?.Content;
const title = t(uiLangFor(topic.data.lang), 'topic.changelog');
---

<TopicLayout
  topic={topic}
  chapters={chapters}
  current="changelog"
  title={title}
  titleInContent={rendered?.headings[0]?.depth === 1}
  path={`/${topic.id}/changelog`}
  isContent={false}
>
  {Content && <Content />}
</TopicLayout>
